@model AdminDictionariesViewModel

@{
    ViewData["Title"] = "Справочники";
}

<div class="row align-items-center mb-4">
    <div class="col">
        <h4 class="mb-1">Справочники</h4>
        <p class="text-muted mb-0">Базовые reference-данные, которые используются в каталоге и формах объявлений.</p>
    </div>
</div>

<div class="row">
    @foreach (var dictionarySection in Model.Sections)
    {
        <div class="col-xl-6">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="card-title mb-0">@dictionarySection.Title</h5>
                        <span class="badge badge-soft-secondary">@dictionarySection.Items.Count</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="thead-light">
                            <tr>
                                <th style="width: 72px;">Id</th>
                                <th>Название</th>
                                <th>Slug</th>
                                <th>Детали</th>
                            </tr>
                            </thead>
                            <tbody>
                            @if (dictionarySection.Items.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">Нет записей.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in dictionarySection.Items)
                                {
                                    <tr>
                                        <td>@item.Id</td>
                                        <td class="font-weight-medium">@item.Name</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Slug) ? "—" : item.Slug)</td>
                                        <td>@(string.IsNullOrWhiteSpace(item.Details) ? "—" : item.Details)</td>
                                    </tr>
                                }
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
