@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - UpperCube Admin</title>
    <link rel="shortcut icon" href="~/upcube/assets/images/favicon.ico"/>
    <link rel="stylesheet" href="~/upcube/assets/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/upcube/assets/css/icons.min.css"/>
    <link rel="stylesheet" href="~/upcube/assets/css/app.min.css"/>
</head>
<body data-sidebar="dark">
<a class="sr-only sr-only-focusable" href="#admin-main-content">Перейти к содержимому</a>
<div id="layout-wrapper">
    <header id="page-topbar">
        <div class="navbar-header">
            <div class="d-flex">
                <div class="navbar-brand-box">
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="logo logo-light">
                        <span class="logo-lg text-white fw-bold">UpperCube</span>
                    </a>
                </div>
            </div>
            <div class="d-flex align-items-center">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-sm btn-light me-2">Сайт</a>
                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-primary">Выйти</button>
                </form>
            </div>
        </div>
    </header>

    <div class="vertical-menu">
        <div data-simplebar class="h-100">
            <div id="sidebar-menu">
                <ul class="metismenu list-unstyled" id="side-menu">
                    <li class="menu-title">Администрирование</li>
                    <li class="@(currentController == "Dashboard" ? "mm-active" : null)"><a asp-area="Admin"
                                                                                            asp-controller="Dashboard"
                                                                                            asp-action="Index"><i
                                class="ti-home" aria-hidden="true"></i><span>Дашборд</span></a>
                    </li>
                    <li class="@(currentController == "Users" ? "mm-active" : null)"><a asp-area="Admin"
                                                                                        asp-controller="Users"
                                                                                        asp-action="Index"><i
                                class="ti-user" aria-hidden="true"></i><span>Пользователи</span></a>
                    </li>
                    <li class="@(currentController == "Moderation" ? "mm-active" : null)"><a asp-area="Admin"
                                                                                             asp-controller="Moderation"
                                                                                             asp-action="Index"><i
                                class="ti-check-box" aria-hidden="true"></i><span>Модерация</span></a></li>
                    <li class="@(currentController == "Dictionaries" ? "mm-active" : null)"><a asp-area="Admin"
                                                                                               asp-controller="Dictionaries"
                                                                                               asp-action="Index"><i
                                class="ti-view-list" aria-hidden="true"></i><span>Справочники</span></a></li>
                    <li class="@(currentController == "Logs" ? "mm-active" : null)"><a asp-area="Admin"
                                                                                       asp-controller="Logs"
                                                                                       asp-action="Audit"><i
                                class="ti-notepad" aria-hidden="true"></i><span>Логи</span></a>
                    </li>
                    <li class="@(currentController == "FeatureCatalog" ? "mm-active" : null)"><a asp-area="Admin"
                                                                                                 asp-controller="FeatureCatalog"
                                                                                                 asp-action="Index"><i
                                class="ti-settings" aria-hidden="true"></i><span>Фичи</span></a></li>
                </ul>
            </div>
        </div>
    </div>

    <main id="admin-main-content" class="main-content">
        <div class="page-content">
            <div class="container-fluid">
                @if (TempData["Success"] is string success)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert" aria-live="polite">
                        @success
                        <button type="button" class="close" data-dismiss="alert" aria-label="Закрыть">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }
                @if (TempData["Warning"] is string warning)
                {
                    <div class="alert alert-warning alert-dismissible fade show" role="alert" aria-live="polite">
                        @warning
                        <button type="button" class="close" data-dismiss="alert" aria-label="Закрыть">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert" aria-live="polite">
                        @error
                        <button type="button" class="close" data-dismiss="alert" aria-label="Закрыть">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    </main>
</div>

<script src="~/upcube/assets/libs/jquery/jquery.min.js"></script>
<script src="~/upcube/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/upcube/assets/libs/metismenu/metisMenu.min.js"></script>
<script src="~/upcube/assets/libs/simplebar/simplebar.min.js"></script>
<script src="~/upcube/assets/js/app.js"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
