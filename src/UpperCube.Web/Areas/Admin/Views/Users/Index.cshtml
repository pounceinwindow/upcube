@model AdminUsersIndexViewModel

@{
    ViewData["Title"] = "Пользователи";
}

<div class="row align-items-center mb-4">
    <div class="col">
        <h4 class="mb-1">Пользователи</h4>
        <p class="text-muted mb-0">Список аккаунтов, ролей и статусов проверки.</p>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover table-nowrap mb-0">
                <thead class="thead-light">
                <tr>
                    <th>Email</th>
                    <th>Имя</th>
                    <th>Роли</th>
                    <th>Email</th>
                    <th>Verified</th>
                    <th>Создан</th>
                    <th class="text-right">Действия</th>
                </tr>
                </thead>
                <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Пользователи не найдены.</td>
                    </tr>
                }
                else
                {
                    foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="font-weight-medium">@user.Email</td>
                            <td>@(string.IsNullOrWhiteSpace(user.FullName) ? "—" : user.FullName)</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge badge-soft-primary mr-1">@role</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(user.EmailConfirmed ? "badge-soft-success" : "badge-soft-warning")">
                                    @(user.EmailConfirmed ? "confirmed" : "pending")
                                </span>
                            </td>
                            <td>
                                <span class="badge @(user.IsVerified ? "badge-soft-success" : "badge-soft-secondary")">
                                    @(user.IsVerified ? "yes" : "no")
                                </span>
                            </td>
                            <td>@user.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td class="text-right">
                                <a asp-area="Admin" asp-controller="Users" asp-action="Details" asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-secondary mr-1">Details</a>
                                <form asp-area="Admin" asp-controller="Users" asp-action="ToggleVerified" asp-route-id="@user.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        @(user.IsVerified ? "Снять verified" : "Verified")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
