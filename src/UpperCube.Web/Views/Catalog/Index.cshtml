@model UpperCube.Web.Models.Catalog.CatalogModelView
@{
    ViewData["Title"] = "Каталог";
}

<section class="flat-section">
    <div class="tf-container">
        <h3 class="mb-4">Каталог объектов</h3>
        <form method="get" asp-controller="Catalog" asp-action="Index" class="row g-3 mb-4">
            <div class="col-md-2">
                <label class="form-label">Город</label>
                <select name="cityId" class="form-select">
                    <option value="">Любой</option>
                    @foreach (var c in Model.Cities)
                    {
                        <option value="@c.Value" selected="@(c.Value == Model.CityId?.ToString())">
                            @c.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Тип Недвижимости</label>
                <select name="propertyTypeId" class="form-select">
                    <option value="">Любой</option>
                    @foreach (var r in Model.PropertyTypes)
                    {
                        <option value="@r.Value" selected="@(r.Value == Model.PropertyTypeId?.ToString())">
                            @r.Text
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Цена от</label>
                <input type="number" name="minPrice" value="@Model.MinPrice" class="form-control"/>
            </div>
            <div class="col-md-2">
                <label class="form-label">Цена до</label>
                <input type="number" name="maxPrice" value="@Model.MaxPrice" class="form-control"/>
            </div>

            <div class="col-md-2">
                <label class="form-label">Комнаты</label>
                <input type="number" name="rooms" value="@Model.Rooms" class="form-control"/>
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="tf-btn primary w-100">Применить</button>
            </div>
        </form>
        <p>Найдено: <b>@Model.TotalCount</b></p>
        <div class="row" id="catalog-grid">
            @foreach (var item in Model.Items)
            {
                <div class="col-xl-4 col-lg-6 col-md-6">
                    <partial name="_PropertyCard" model="item"/>
                </div>
            }
        </div>

        @{
            var pageSize = 9;
            var totalPages = (int)Math.Ceiling((double)Model.TotalCount / pageSize);
            var hasMore = Model.Page < totalPages;
        }

        @if (hasMore)
        {
            <div class="text-center mt-4">
                <button type="button" id="load-more-btn" class="tf-btn primary"
                        data-next-page="@(Model.Page + 1)"
                        data-total-pages="@totalPages">
                    Показать ещё
                </button>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            const btn = document.getElementById('load-more-btn');
            if (!btn) return;

            btn.addEventListener('click', async function () {
                const nextPage = parseInt(btn.dataset.nextPage, 10);
                const totalPages = parseInt(btn.dataset.totalPages, 10);

                const params = new URLSearchParams(window.location.search);
                params.set('page', nextPage);

                const res = await fetch('@Url.Action("LoadMore", "Catalog")?' + params.toString());
                if (!res.ok) return;

                const html = await res.text();
                const grid = document.getElementById('catalog-grid');
                grid.insertAdjacentHTML('beforeend', html);

                if (nextPage + 1 > totalPages) {
                    btn.remove();
                } else {
                    btn.dataset.nextPage = (nextPage + 1).toString();
                }
            });
        })();
    </script>
}
