@model UpperCube.Web.Models.Agent.PropertyFormModelView

@{
    ViewData["Title"] = "Создать объявление";
}

<section class="flat-section">
    <div class="tf-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="mb-1">Создать объявление</h3>
                <p class="text-variant-1 mb-0">Заполните данные объекта недвижимости</p>
            </div>

            <a asp-controller="Agent"
               asp-action="MyProperties"
               class="btn btn-outline-secondary">
                Назад
            </a>
        </div>

        <form asp-controller="Agent"
              asp-action="Create"
              method="post"
              enctype="multipart/form-data"
              class="homelengo-box p-4">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label">Название</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="TransactionType" class="form-label">Тип сделки</label>
                    <select asp-for="TransactionType" class="form-select">
                        <option value="1">Продажа</option>
                        <option value="2">Аренда</option>
                    </select>
                    <span asp-validation-for="TransactionType" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Price" class="form-label">Цена</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="col-md-2">
                    <label asp-for="Currency" class="form-label">Валюта</label>
                    <input asp-for="Currency" class="form-control" maxlength="3" />
                    <span asp-validation-for="Currency" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Area" class="form-label">Площадь</label>
                    <input asp-for="Area" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Area" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Rooms" class="form-label">Комнаты</label>
                    <input asp-for="Rooms" type="number" class="form-control" />
                    <span asp-validation-for="Rooms" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="Floor" class="form-label">Этаж</label>
                    <input asp-for="Floor" type="number" class="form-control" />
                    <span asp-validation-for="Floor" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="TotalFloors" class="form-label">Всего этажей</label>
                    <input asp-for="TotalFloors" type="number" class="form-control" />
                    <span asp-validation-for="TotalFloors" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="CityId" class="form-label">Город</label>
                    <select asp-for="CityId" asp-items="Model.Cities" class="form-select">
                        <option value="">Выберите город</option>
                    </select>
                    <span asp-validation-for="CityId" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="DistrictId" class="form-label">Район</label>
                    <select asp-for="DistrictId" asp-items="Model.Districts" class="form-select">
                        <option value="">Выберите район</option>
                    </select>
                    <span asp-validation-for="DistrictId" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="PropertyTypeId" class="form-label">Тип недвижимости</label>
                    <select asp-for="PropertyTypeId" asp-items="Model.PropertyTypes" class="form-select">
                        <option value="">Выберите тип</option>
                    </select>
                    <span asp-validation-for="PropertyTypeId" class="text-danger"></span>
                </div>

                <div class="col-md-3">
                    <label asp-for="CategoryId" class="form-label">Категория</label>
                    <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                        <option value="">Выберите категорию</option>
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Address" class="form-label">Адрес</label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>

                <div class="col-12 d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Создать
                    </button>

                    <a asp-controller="Agent"
                       asp-action="MyProperties"
                       class="btn btn-outline-secondary">
                        Отмена
                    </a>
                </div>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}