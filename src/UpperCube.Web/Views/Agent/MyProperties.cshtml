@model IReadOnlyList<UpperCube.Application.DTOs.PropertyListItemDto>

@{
    ViewData["Title"] = "Мои объявления";
}

<section class="flat-section">
    <div class="tf-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="mb-1">Мои объявления</h3>
                <p class="text-variant-1 mb-0">Управление объектами недвижимости агента</p>
            </div>

            <a asp-controller="Agent" asp-action="Create" class="tf-btn primary">
                Добавить объект
            </a>
        </div>

        @if (TempData["AgentMessage"] is string message)
        {
            <div class="alert alert-success">@message</div>
        }

        @if (!Model.Any())
        {
            <div class="homelengo-box p-4 text-center">
                <h5>Объявлений пока нет</h5>
                <p class="text-variant-1">Создай первый объект недвижимости.</p>
                <a asp-controller="Agent" asp-action="Create" class="tf-btn primary">
                    Создать объявление
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-xl-4 col-lg-6 col-md-6">
                        <partial name="_PropertyCard" model="item" />

                        <div class="d-flex gap-2 mt-2">
                            <a asp-controller="Agent"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-outline-primary w-50">
                                Редактировать
                            </a>

                            <form asp-controller="Agent"
                                  asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="w-50"
                                  onsubmit="return confirm('Удалить объявление?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    Удалить
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>