@model UpperCube.Web.Models.Agent.PropertyFormModelView

@{
    ViewData["Title"] = "Редактировать объявление";
    ViewData["AgentFormAction"] = "Edit";
    ViewData["AgentFormSubmit"] = "Сохранить";
}

<section class="flat-section">
    <div class="tf-container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="mb-1">Редактировать объявление</h3>
                <p class="text-variant-1 mb-0">Обновите публичные данные объекта.</p>
            </div>

            <a asp-controller="Agent"
               asp-action="MyProperties"
               class="btn btn-outline-secondary">
                Назад
            </a>
        </div>

        <partial name="_PropertyForm" model="Model"/>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
