<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - UpperCube</title>
    <link rel="shortcut icon" href="~/upcube/assets/images/favicon.ico"/>
    <link rel="stylesheet" href="~/upcube/assets/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/upcube/assets/css/icons.min.css"/>
    <link rel="stylesheet" href="~/upcube/assets/css/app.min.css"/>
</head>
<body class="auth-body-bg">
<div class="bg-overlay"></div>
<div class="wrapper-page">
    <div class="container-fluid p-0">
        <div class="card">
            <div class="card-body">
                <div class="text-center mt-4">
                    <div class="mb-3">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="auth-logo">
                            <img alt="UpperCube" class="logo-dark mx-auto" height="30" width="104"
                                 src="~/homelengo/images/logo/logo.png">
                            <img alt="UpperCube" class="logo-light mx-auto" height="30" width="137"
                                 src="~/upcube/assets/images/logo-light.png">
                        </a>
                    </div>
                </div>
                <main>
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>
</div>
<script src="~/upcube/assets/libs/jquery/jquery.min.js"></script>
<script src="~/upcube/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="~/upcube/assets/js/app.js"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
