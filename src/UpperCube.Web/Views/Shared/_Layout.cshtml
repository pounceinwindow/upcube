@using System.Globalization
@using Microsoft.Extensions.Localization
@using UpperCube.Web
@inject IStringLocalizer<SharedResource> Localizer

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>@ViewData["Title"] - UpperCube</title>
    <link rel="shortcut icon" href="~/homelengo/images/logo/favicon.png"/>
    <link rel="apple-touch-icon-precomposed" href="~/homelengo/images/logo/favicon.png"/>
    <link rel="stylesheet" href="~/homelengo/fonts/fonts.css"/>
    <link rel="stylesheet" href="~/homelengo/fonts/font-icons.css"/>
    <link rel="stylesheet" href="~/homelengo/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/homelengo/css/swiper-bundle.min.css"/>
    <link rel="stylesheet" href="~/homelengo/css/animate.css"/>
    <link rel="stylesheet" href="~/homelengo/css/jquery.fancybox.min.css"/>
    <link rel="stylesheet" href="~/homelengo/css/styles.css"/>
    <link rel="stylesheet" href="~/css/favorites.css">
    <link rel="stylesheet" href="~/css/inquiry-chat.css"/>
    <link rel="stylesheet" href="~/css/uppercube-home.css" asp-append-version="true"/>
</head>
<body class="body">
<a class="uc-skip-link" href="#main-content">@Localizer["SkipToContent"]</a>
<form class="uc-antiforgery-token" aria-hidden="true">
    @Html.AntiForgeryToken()
</form>
<div class="preload preload-container">
    <div class="preload-logo">
        <div class="spinner"></div>
        <span class="icon icon-villa-fill"></span>
    </div>
</div>

<div id="wrapper">
    <div id="pagee" class="clearfix">
        <header class="main-header fixed-header uppercube-header">
            <div class="header-lower">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="inner-header">
                            <div class="inner-header-left">
                                <div class="logo-box flex">
                                    <div class="logo">
                                        <a asp-area="" asp-controller="Home" asp-action="Index">
                                            <img src="~/homelengo/images/logo/logo@2x.png" alt="UpperCube" width="166"
                                                 height="48"/>
                                        </a>
                                    </div>
                                </div>
                                <div class="nav-outer flex align-center uppercube-nav-outer">
                                    <nav class="main-menu show navbar-expand-md">
                                        <div class="navbar-collapse collapse clearfix" id="navbarSupportedContent">
                                            <ul class="navigation clearfix uppercube-navigation">
                                                <li><a asp-area="" asp-controller="Home"
                                                       asp-action="Index">@Localizer["Home"]</a></li>
                                                <li><a asp-area="" asp-controller="Catalog"
                                                       asp-action="Index">@Localizer["Catalog"]</a></li>
                                                <li><a asp-area="" asp-controller="Estimator"
                                                       asp-action="Index">@Localizer["Estimator"]</a></li>
                                                <li><a asp-area="" asp-controller="Compare"
                                                       asp-action="Index">@Localizer["Compare"]</a></li>
                                                @if (User.Identity?.IsAuthenticated == true)
                                                {
                                                    <li><a asp-area="" asp-controller="Account"
                                                           asp-action="Dashboard">@Localizer["Dashboard"]</a></li>
                                                    <li><a asp-area="" asp-controller="Account"
                                                           asp-action="Favorites">@Localizer["Favorites"]</a></li>
                                                    <li><a asp-area="" asp-controller="Account"
                                                           asp-action="Inquiries">@Localizer["Inquiries"]</a></li>
                                                    <li><a asp-area="" asp-controller="Account"
                                                           asp-action="Profile">@Localizer["Profile"]</a></li>
                                                }
                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <li><a asp-area="Admin" asp-controller="Dashboard"
                                                           asp-action="Index">@Localizer["Admin"]</a></li>
                                                }
                                            </ul>
                                        </div>
                                    </nav>
                                </div>
                            </div>
                            <div class="inner-header-right header-account uppercube-header-actions">
                                <a asp-controller="Culture" asp-action="Set" asp-route-culture="ru"
                                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                   class="tf-btn btn-line uppercube-btn uppercube-btn-lang">RU</a>
                                <a asp-controller="Culture" asp-action="Set" asp-route-culture="en"
                                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                                   class="tf-btn btn-line uppercube-btn uppercube-btn-lang">EN</a>
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-area="" asp-controller="Account" asp-action="Logout" method="post"
                                          class="d-inline uppercube-auth-form">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="tf-btn primary uppercube-btn uppercube-btn-main">@Localizer["Logout"]</button>
                                    </form>
                                }
                                else
                                {
                                    <a asp-area="" asp-controller="Account" asp-action="Login"
                                       class="tf-btn btn-line btn-login uppercube-btn uppercube-btn-auth">@Localizer["Login"]</a>
                                    <div class="flat-bt-top">
                                        <a asp-area="" asp-controller="Account" asp-action="Register"
                                           class="tf-btn primary uppercube-btn uppercube-btn-main">@Localizer["Register"]</a>
                                    </div>
                                }
                            </div>
                            <div class="mobile-nav-toggler mobile-button"><span></span></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="close-btn"><span class="icon flaticon-cancel-1"></span></div>
            <div class="mobile-menu">
                <div class="menu-backdrop"></div>
                <nav class="menu-box">
                    <div class="nav-logo">
                        <a asp-area="" asp-controller="Home" asp-action="Index">
                            <img src="~/homelengo/images/logo/logo@2x.png" alt="UpperCube" width="174" height="44"/>
                        </a>
                    </div>
                    <div class="bottom-canvas">
                        <div class="login-box flex align-center">
                            <div class="uppercube-mobile-langs">
                                <a asp-controller="Culture" asp-action="Set" asp-route-culture="ru"
                                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">RU</a>
                                <a asp-controller="Culture" asp-action="Set" asp-route-culture="en"
                                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString">EN</a>
                            </div>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post"
                                      class="uppercube-auth-form">
                                    @Html.AntiForgeryToken()
                                    <button type="submit"
                                            class="tf-btn primary uppercube-btn uppercube-btn-main">@Localizer["Logout"]</button>
                                </form>
                            }
                            else
                            {
                                <a asp-area="" asp-controller="Account" asp-action="Login">@Localizer["Login"]</a>
                                <span>/</span>
                                <a asp-area="" asp-controller="Account" asp-action="Register">@Localizer["Register"]</a>
                            }
                        </div>
                        <div class="menu-outer"></div>
                    </div>
                </nav>
            </div>
        </header>

        <main id="main-content" role="main">
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/homelengo/js/jquery.min.js"></script>
<script src="~/homelengo/js/bootstrap.min.js"></script>
<script src="~/homelengo/js/swiper-bundle.min.js"></script>
<script src="~/homelengo/js/carousel.js"></script>
<script src="~/homelengo/js/plugin.js"></script>
<script src="~/homelengo/js/jquery.nice-select.min.js"></script>
<script src="~/homelengo/js/animation_heading.js"></script>
<script src="~/homelengo/js/rangle-slider.js"></script>
<script src="~/homelengo/js/shortcodes.js"></script>
<script src="~/homelengo/js/lazysize.min.js"></script>
<script src="~/homelengo/js/main.js"></script>
<script src="~/js/favorites.js"></script>
@await RenderSectionAsync("Scripts", false)
</body>
</html>
