@model UpperCube.Application.DTOs.PropertyDetailsDto
@{
    ViewData["Title"] = Model.Title;
    var detailImages = Model.Images
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList();

    if (!detailImages.Any())
    {
        detailImages.Add("/images/banner/banner-property-1.jpg");
    }
}

<section class="flat-section">
    <div class="tf-container">
        <h1>@Model.Title</h1>
        <p class="text-variant-1">
            @Model.City, @Model.District, @Model.Address
        </p>

        <h2>@Model.Price.ToString("N0") @Model.Currency</h2>

        <div class="flat-slider-detail-v1 uc-property-detail-gallery mt-4">
            <div class="swiper tf-sw-location" data-mobile="1" data-mobile-sm="2" data-pagination="1"
                 data-pagination-lg="3" data-pagination-md="2" data-pagination-sm="2" data-preview="3"
                 data-space="10" data-space-lg="10" data-space-md="10" data-tablet="2" dir="ltr">
                <div class="swiper-wrapper">
                    @foreach (var imagePath in detailImages)
                    {
                        <div class="swiper-slide">
                            <a class="box-img-detail d-block" data-fancybox="gallery" href="@imagePath">
                                <img alt="@Model.Title" src="@imagePath">
                            </a>
                        </div>
                    }
                </div>

                @if (detailImages.Count > 1)
                {
                    <div class="sw-pagination sw-pagination-location text-center"></div>
                }
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-3"><strong>Тип:</strong> @Model.PropertyType</div>
            <div class="col-md-3"><strong>Категория:</strong> @Model.Category</div>
            <div class="col-md-3"><strong>Сделка:</strong> @(Model.TransactionType == 0 ? "Продажа" : "Аренда")</div>
            <div class="col-md-3"><strong>Площадь:</strong> @Model.Area.ToString("F0") м²</div>
        </div>

        <div class="row mt-3">
            <div class="col-md-3"><strong>Комнат:</strong> @Model.Rooms</div>
            <div class="col-md-3"><strong>Этаж:</strong> @Model.Floor / @Model.TotalFloors</div>
            <div class="col-md-3"><strong>Просмотров:</strong> @Model.ViewsCount</div>
            <div class="col-md-3"><strong>Агент:</strong> @Model.AgentName</div>
        </div>

        <h3 class="mt-4">Описание</h3>
        <p>@Model.Description</p>

        @if (Model.Amenities.Any())
        {
            <h3 class="mt-4">Удобства</h3>
            <ul>
                @foreach (var a in Model.Amenities)
                {
                    <li>@a</li>
                }
            </ul>
        }
    </div>
</section>
