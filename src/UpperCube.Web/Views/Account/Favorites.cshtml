@model IReadOnlyList<UpperCube.Application.DTOs.PropertyListItemDto>
@{
    ViewData["Title"] = "Избранное";
}

<section class="flat-section">
    <div class="tf-container">
        <h3 class="mb-4">Избранное (@Model.Count)</h3>

        @if (Model.Count == 0)
        {
            <p class="text-center text-variant-1">У вас пока нет избранных объектов.</p>
        }
        else
        {
            <div class="row">
                @foreach (var item in Model)
                {
                    <div class="col-xl-4 col-lg-6 col-md-6">
                        <partial name="_PropertyCard" model="item"/>
                    </div>
                }
            </div>
        }
    </div>
</section>
