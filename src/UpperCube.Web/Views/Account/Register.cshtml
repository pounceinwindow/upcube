@model RegisterViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Регистрация";
}

<h4 class="text-muted text-center font-size-18"><b>Регистрация</b></h4>

<div class="p-3">
    <form asp-action="Register" method="post" class="form-horizontal mt-3">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" aria-live="polite"></div>

        <div class="form-group mb-3 row">
            <div class="col-12">
                <label asp-for="Email" class="sr-only">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Email" autocomplete="email"
                       inputmode="email" spellcheck="false"/>
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3 row">
            <div class="col-12">
                <label asp-for="FirstName" class="sr-only">Имя</label>
                <input asp-for="FirstName" class="form-control" placeholder="Имя"/>
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3 row">
            <div class="col-12">
                <label asp-for="LastName" class="sr-only">Фамилия</label>
                <input asp-for="LastName" class="form-control" placeholder="Фамилия"/>
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3 row">
            <div class="col-12">
                <label asp-for="Password" class="sr-only">Пароль</label>
                <input asp-for="Password" class="form-control" placeholder="Пароль" autocomplete="new-password"/>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3 row">
            <div class="col-12">
                <label asp-for="ConfirmPassword" class="sr-only">Повторите пароль</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Повторите пароль"
                       autocomplete="new-password"/>
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3 row">
            <div class="col-12">
                <div class="custom-control custom-checkbox">
                    <input asp-for="AcceptTerms" class="custom-control-input" required/>
                    <label asp-for="AcceptTerms" class="custom-control-label form-label ms-1 fw-normal">
                        Я принимаю <a class="text-muted" asp-controller="Home" asp-action="Index">условия сервиса</a>
                    </label>
                    <span asp-validation-for="AcceptTerms" class="text-danger d-block"></span>
                </div>
            </div>
        </div>

        <div class="form-group text-center row mt-3 pt-1">
            <div class="col-12">
                <button class="btn btn-info w-100 waves-effect waves-light" type="submit">Создать аккаунт</button>
            </div>
        </div>

        <div class="form-group mb-0 row mt-2">
            <div class="col-12 mt-3 text-center">
                <a asp-action="Login" class="text-muted"><i class="mdi mdi-account-circle" aria-hidden="true"></i> Уже
                    есть аккаунт?</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
