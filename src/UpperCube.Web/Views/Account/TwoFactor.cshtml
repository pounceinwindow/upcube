@model TwoFactorViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "2FA";
}

<h4 class="text-muted text-center font-size-18"><b>Двухфакторная проверка</b></h4>

<div class="p-3">
    <form asp-action="TwoFactor" method="post" class="form-horizontal mt-3">
        @Html.AntiForgeryToken()
        <input asp-for="RememberMe" type="hidden"/>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="form-group mb-3 row">
            <div class="col-12">
                <input asp-for="Code" class="form-control" placeholder="Код" autocomplete="one-time-code"/>
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group mb-3 row">
            <div class="col-12">
                <div class="custom-control custom-checkbox">
                    <input asp-for="RememberMachine" class="custom-control-input"/>
                    <label asp-for="RememberMachine" class="form-label ms-1">Запомнить устройство</label>
                </div>
            </div>
        </div>

        <div class="form-group text-center row mt-3 pt-1">
            <div class="col-12">
                <button class="btn btn-info w-100 waves-effect waves-light" type="submit">Подтвердить</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}
